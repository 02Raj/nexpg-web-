EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# APK upload → Cloudflare R2 (recommended free). See docs/apk-hosting-r2.md
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=runmypg-releases
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# APK_OBJECT_KEY=runmypg.apk

# Optional: Supabase Storage upload (needs Pro for ~77MB APK)
# SUPABASE_SERVICE_ROLE_KEY=
