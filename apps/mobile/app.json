{
  "expo": {
    "name": "RunMyPG",
    "owner": "divyansh_02",
    "slug": "nexpg",
    "scheme": "runmypg",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.runmypg.app"
    },
    "android": {
      "package": "in.runmypg.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#16302B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F1",
          "image": "./assets/splash-icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74a3c568-0063-4861-8dd7-ba2d9ede50b3"
      }
    }
  }
}
