{
  "name": "nexpg-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@nexpg/web",
    "dev:mobile": "npm run start --workspace=@nexpg/mobile",
    "android": "npm run android --workspace=@nexpg/mobile",
    "ios": "npm run ios --workspace=@nexpg/mobile",
    "build:web": "npm run build --workspace=@nexpg/web",
    "vercel-build": "npm run build:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm run test",
    "ping:supabase": "node scripts/keep-supabase-alive.mjs",
    "leads:scrape": "node scripts/scrape-and-pitch.mjs",
    "clean": "node scripts/clean-workspaces.mjs"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "devDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
