# Copy to .env.local (recommended) or .env — never commit keys.
# Required — same key as TutorPe / RunMyPG app (script + voiceover)
SARVAM_API_KEY=

# Brand: tutorpe | runmypg
BRAND=tutorpe

# Script: sarvam (default, no Ollama) | ollama | template (offline)
SCRIPT_PROVIDER=sarvam

# Captions: off (light, default) | tiny | small (needs: pip install faster-whisper)
WHISPER_MODE=off

# Optional voice
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_LANG=en-IN
SARVAM_CHAT_MODEL=sarvam-105b

# Only if SCRIPT_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct
